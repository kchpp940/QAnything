# ============================================================
# QAnything 统一环境变量契约
# 本文件是所有环境变量的单一事实来源（Single Source of Truth）
# 使用方法：复制为 .env 后按需修改
# ============================================================

# ------------------------------------------------------------
# 一、基础运行配置
# ------------------------------------------------------------

# 服务监听地址（后端 API 服务绑定的 host）
# 本地开发用 0.0.0.0，容器内用 0.0.0.0
QANYTHING_HOST=0.0.0.0

# 后端 API 服务端口
QANYTHING_PORT=8777

# Sanic worker 数量
QANYTHING_WORKERS=1

# GPU 设备 ID（-1 表示使用 CPU）
GPUID=-1

# 网关/宿主机 IP
# - 本地直连: localhost
# - Docker Desktop (Mac/Win): host.docker.internal
# - Docker Linux (host 模式): 127.0.0.1
# - 远程服务器: 服务器公网 IP
GATEWAY_IP=localhost

# 用户访问 IP（用于打印访问地址，不影响实际监听）
USER_IP=localhost

# ------------------------------------------------------------
# 二、MySQL 数据库连接
# ------------------------------------------------------------

MYSQL_HOST=localhost
MYSQL_PORT=3316
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=qanything

# ------------------------------------------------------------
# 三、Milvus 向量数据库连接
# ------------------------------------------------------------

MILVUS_HOST=localhost
MILVUS_PORT=19540
MILVUS_COLLECTION_NAME=qanything_collection

# Milvus 依赖服务
ETCD_ENDPOINTS=localhost:2379
MINIO_ADDRESS=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ------------------------------------------------------------
# 四、Elasticsearch 连接
# ------------------------------------------------------------

ES_HOST=localhost
ES_PORT=9210
ES_USER=
ES_PASSWORD=
ES_INDEX_NAME=qanything_es_index
ES_TOP_K=30

# ------------------------------------------------------------
# 五、本地依赖服务端口（Embedding / Rerank / OCR / PDF Parser）
# ------------------------------------------------------------

# Embedding 服务
EMBED_SERVICE_HOST=localhost
EMBED_SERVICE_PORT=9001

# Rerank 服务
RERANK_SERVICE_HOST=localhost
RERANK_SERVICE_PORT=8001

# OCR 服务
OCR_SERVICE_HOST=localhost
OCR_SERVICE_PORT=7001

# PDF 解析服务
PDF_PARSER_SERVICE_HOST=localhost
PDF_PARSER_SERVICE_PORT=9009

# 文件插入服务
INSERT_FILES_SERVICE_PORT=8110

# ------------------------------------------------------------
# 六、知识库 / 检索配置
# ------------------------------------------------------------

# 知识库版本后缀（用于区分不同版本的索引）
KB_SUFFIX=_240625

# 向量检索 Top-K
VECTOR_SEARCH_TOP_K=30

# 向量检索分数阈值
VECTOR_SEARCH_SCORE_THRESHOLD=0.3

# 缓存的知识库数量
CACHED_VS_NUM=100

# 分句长度
SENTENCE_SIZE=100

# 默认子 chunk 大小
DEFAULT_CHILD_CHUNK_SIZE=400

# 默认父 chunk 大小
DEFAULT_PARENT_CHUNK_SIZE=800

# 单个文件最大字符数
MAX_CHARS=1000000

# ------------------------------------------------------------
# 七、文件存储路径
# ------------------------------------------------------------

# 上传文件根目录（相对项目根目录）
UPLOAD_ROOT_PATH=QANY_DB/content

# Docker 卷挂载根目录（仅 docker compose 使用）
DOCKER_VOLUME_DIRECTORY=.

# ------------------------------------------------------------
# 八、前端相关
# ------------------------------------------------------------

# 前端 API 基地址（开发模式走代理，生产模式可填绝对地址）
VITE_APP_API_HOST=/api

# API 前缀
VITE_APP_API_PREFIX=/api

# 前端 Web 路径前缀
VITE_APP_WEB_PREFIX=/qanything

# 运行模式: dev | prod
VITE_APP_MODE=dev

# 开发模式 Vite 代理目标地址（指向后端 API 服务）
VITE_DEV_PROXY_TARGET=http://localhost:8777

# ------------------------------------------------------------
# 九、Docker 镜像配置
# ------------------------------------------------------------

# QAnything 主镜像（通用占位符，被平台覆盖文件替换）
QANYTHING_IMAGE=xixihahaliu01/qanything-linux:v1.5.1

# QAnything 镜像（不同平台）
QANYTHING_IMAGE_LINUX=xixihahaliu01/qanything-linux:v1.5.1
QANYTHING_IMAGE_MAC=xixihahaliu01/qanything-mac:v1.5.1
QANYTHING_IMAGE_WIN=xixihahaliu01/qanything-win:v1.5.1

# Milvus 镜像
MILVUS_IMAGE=milvusdb/milvus:v2.4.8

# Elasticsearch 镜像
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.2

# Etcd 镜像
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5

# MinIO 镜像
MINIO_IMAGE=minio/minio:RELEASE.2023-03-20T20-16-18Z

# MySQL 镜像
MYSQL_IMAGE=mysql:8.4

# ------------------------------------------------------------
# 十、其他
# ------------------------------------------------------------

# 是否流式响应
STREAMING=true

# TikToken 缓存目录
TIKTOKEN_CACHE_DIR=
