# ============================================================
# QAnything 统一环境变量契约
# ============================================================
#
# ⚠️   此文件由 scripts/generate_env_example.py 自动生成，请勿手动修改！
# 📋 来源配置：config/env_schema.yaml  (schema_version=1.0)
# 🔧 生成时间：2026-06-21 10:03:17
#
# 使用方法：
#   cp .env.example .env        # 复制为本地配置
#   vim .env                     # 按需修改本地值
#
# 新增/修改变量：
#   1) 编辑 config/env_schema.yaml
#   2) 运行 python scripts/generate_env_example.py --write
#   3) 运行 python scripts/validate_env.py 做一致性校验
#

# ------------------------------------------------------------
# 1、基础运行配置
#     服务启动模式、监听地址、Worker 数等基础参数
# ------------------------------------------------------------

# 后端 API 服务绑定的 host 地址
#   └─ 类型: string  默认值='0.0.0.0'
QANYTHING_HOST=0.0.0.0

# 后端 API 服务端口号
#   └─ 类型: int  默认值='8777'
QANYTHING_PORT=8777

# Sanic worker 进程数量（本地开发建议 1，生产环境建议 4）
#   └─ 类型: int  默认值='1'
QANYTHING_WORKERS=1

# GPU 设备 ID，-1 表示使用 CPU
#   └─ 类型: int  默认值='-1'
GPUID=-1

# 网关/宿主机 IP。本地:localhost，Docker Desktop:host.docker.internal，Docker Linux host模式:127.0.0.1
#   └─ 类型: string  默认值='localhost'
GATEWAY_IP=localhost

# 用户访问 IP（仅用于打印访问地址，不影响实际监听）
#   └─ 类型: string  默认值='localhost'
USER_IP=localhost

# 是否启用流式响应
#   └─ 类型: bool  默认值='true'
STREAMING=true

# ------------------------------------------------------------
# 2、MySQL 数据库连接
#     本地 MySQL / MariaDB 连接参数
# ------------------------------------------------------------

# 【必填】MySQL 数据库主机地址
#   └─ 类型: string  默认值='localhost'
MYSQL_HOST=localhost

# 【必填】MySQL 数据库端口（宿主机映射端口）
#   └─ 类型: int  默认值='3316'
MYSQL_PORT=3316

# 【必填】MySQL 用户名
#   └─ 类型: string  默认值='root'
MYSQL_USER=root

# 【必填】MySQL 密码
#   └─ 类型: string  默认值='123456'
MYSQL_PASSWORD=123456

# 【必填】MySQL 数据库名
#   └─ 类型: string  默认值='qanything'
MYSQL_DATABASE=qanything

# ------------------------------------------------------------
# 3、Milvus 向量数据库连接
#     Milvus、Etcd、MinIO 连接参数
# ------------------------------------------------------------

# 【必填】Milvus 向量数据库主机地址
#   └─ 类型: string  默认值='localhost'
MILVUS_HOST=localhost

# 【必填】Milvus 向量数据库端口（宿主机映射端口）
#   └─ 类型: int  默认值='19540'
MILVUS_PORT=19540

# Milvus Collection 名称前缀（会拼接 KB_SUFFIX）
#   └─ 类型: string  默认值='qanything_collection'
MILVUS_COLLECTION_NAME=qanything_collection

# Milvus 依赖的 etcd 服务地址
#   └─ 类型: string  默认值='localhost:2379'
ETCD_ENDPOINTS=localhost:2379

# Milvus 依赖的 MinIO 服务地址
#   └─ 类型: string  默认值='localhost:9000'
MINIO_ADDRESS=localhost:9000

# MinIO 访问密钥
#   └─ 类型: string  默认值='minioadmin'
MINIO_ACCESS_KEY=minioadmin

# MinIO 密钥
#   └─ 类型: string  默认值='minioadmin'
MINIO_SECRET_KEY=minioadmin

# ------------------------------------------------------------
# 4、Elasticsearch 连接
#     Elasticsearch 连接和检索参数
# ------------------------------------------------------------

# 【必填】Elasticsearch 主机地址
#   └─ 类型: string  默认值='localhost'
ES_HOST=localhost

# 【必填】Elasticsearch 端口（宿主机映射端口）
#   └─ 类型: int  默认值='9210'
ES_PORT=9210

# Elasticsearch 用户名（未启用鉴权则留空）
#   └─ 类型: string
ES_USER=

# Elasticsearch 密码（未启用鉴权则留空）
#   └─ 类型: string
ES_PASSWORD=

# ES 索引名称前缀（会拼接 KB_SUFFIX）
#   └─ 类型: string  默认值='qanything_es_index'
ES_INDEX_NAME=qanything_es_index

# ES 检索返回的 Top-K 数量
#   └─ 类型: int  默认值='30'
ES_TOP_K=30

# ------------------------------------------------------------
# 5、本地依赖服务端口
#     Embedding、Rerank、OCR、PDF 解析等依赖服务
# ------------------------------------------------------------

# Embedding 服务主机地址
#   └─ 类型: string  默认值='localhost'
EMBED_SERVICE_HOST=localhost

# Embedding 服务端口
#   └─ 类型: int  默认值='9001'
EMBED_SERVICE_PORT=9001

# Rerank 服务主机地址
#   └─ 类型: string  默认值='localhost'
RERANK_SERVICE_HOST=localhost

# Rerank 服务端口
#   └─ 类型: int  默认值='8001'
RERANK_SERVICE_PORT=8001

# OCR 服务主机地址
#   └─ 类型: string  默认值='localhost'
OCR_SERVICE_HOST=localhost

# OCR 服务端口
#   └─ 类型: int  默认值='7001'
OCR_SERVICE_PORT=7001

# PDF 解析服务主机地址
#   └─ 类型: string  默认值='localhost'
PDF_PARSER_SERVICE_HOST=localhost

# PDF 解析服务端口
#   └─ 类型: int  默认值='9009'
PDF_PARSER_SERVICE_PORT=9009

# 文件入库异步服务端口
#   └─ 类型: int  默认值='8110'
INSERT_FILES_SERVICE_PORT=8110

# ------------------------------------------------------------
# 6、知识库与检索配置
#     向量检索阈值、分块大小、句子长度等
# ------------------------------------------------------------

# 知识库版本后缀，区分不同版本的索引/表结构
#   └─ 类型: string  默认值='_240625'
KB_SUFFIX=_240625

# 向量检索 Top-K 数量
#   └─ 类型: int  默认值='30'
VECTOR_SEARCH_TOP_K=30

# 向量检索分数阈值，低于此值的结果会被过滤
#   └─ 类型: float  默认值='0.3'
VECTOR_SEARCH_SCORE_THRESHOLD=0.3

# 缓存的向量库数量
#   └─ 类型: int  默认值='100'
CACHED_VS_NUM=100

# 分句长度（字符数）
#   └─ 类型: int  默认值='100'
SENTENCE_SIZE=100

# 默认子块大小（字符数）
#   └─ 类型: int  默认值='400'
DEFAULT_CHILD_CHUNK_SIZE=400

# 默认父块大小（字符数）
#   └─ 类型: int  默认值='800'
DEFAULT_PARENT_CHUNK_SIZE=800

# 单个文件最大允许字符数，超过则标记为失败
#   └─ 类型: int  默认值='1000000'
MAX_CHARS=1000000

# ------------------------------------------------------------
# 7、文件存储路径
#     上传文件、Docker 卷、缓存目录等
# ------------------------------------------------------------

# 上传文件存储根目录（相对项目根目录）
#   └─ 类型: string  默认值='QANY_DB/content'
UPLOAD_ROOT_PATH=QANY_DB/content

# Docker 卷挂载根目录（仅 compose 中使用）
#   └─ 类型: string  默认值='.'
DOCKER_VOLUME_DIRECTORY=.

# TikToken 缓存目录（Dockerfile 中预填充）
#   └─ 类型: string
TIKTOKEN_CACHE_DIR=

# ------------------------------------------------------------
# 8、前端相关
#     Vite 开发模式、API 地址、路径前缀等
# ------------------------------------------------------------

# 前端 API 基地址（开发模式走代理，生产可填绝对地址）
#   └─ 类型: string  默认值='/api'
VITE_APP_API_HOST=/api

# API 路由前缀
#   └─ 类型: string  默认值='/api'
VITE_APP_API_PREFIX=/api

# 前端 Web 路径前缀
#   └─ 类型: string  默认值='/qanything'
VITE_APP_WEB_PREFIX=/qanything

# 运行模式: dev | prod
#   └─ 类型: string  默认值='dev'
VITE_APP_MODE=dev

# 开发模式 Vite 代理目标地址（指向后端 API）
#   └─ 类型: string  默认值='http://localhost:8777'
VITE_DEV_PROXY_TARGET=http://localhost:8777

# ------------------------------------------------------------
# 9、Docker 镜像配置
#     各组件 Docker 镜像版本标签
# ------------------------------------------------------------

# QAnything 主镜像占位符（被平台覆盖文件替换）
#   └─ 类型: string  默认值='xixihahaliu01/qanything-linux:v1.5.1'
QANYTHING_IMAGE=xixihahaliu01/qanything-linux:v1.5.1

# Linux 平台 QAnything 镜像
#   └─ 类型: string  默认值='xixihahaliu01/qanything-linux:v1.5.1'
QANYTHING_IMAGE_LINUX=xixihahaliu01/qanything-linux:v1.5.1

# macOS 平台 QAnything 镜像
#   └─ 类型: string  默认值='xixihahaliu01/qanything-mac:v1.5.1'
QANYTHING_IMAGE_MAC=xixihahaliu01/qanything-mac:v1.5.1

# Windows 平台 QAnything 镜像
#   └─ 类型: string  默认值='xixihahaliu01/qanything-win:v1.5.1'
QANYTHING_IMAGE_WIN=xixihahaliu01/qanything-win:v1.5.1

# Milvus 向量数据库镜像
#   └─ 类型: string  默认值='milvusdb/milvus:v2.4.8'
MILVUS_IMAGE=milvusdb/milvus:v2.4.8

# Elasticsearch 镜像
#   └─ 类型: string  默认值='docker.elastic.co/elasticsearch/elasticsearch:8.13.2'
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.2

# Etcd 镜像（Milvus 元数据存储）
#   └─ 类型: string  默认值='quay.io/coreos/etcd:v3.5.5'
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5

# MinIO 镜像（Milvus 对象存储）
#   └─ 类型: string  默认值='minio/minio:RELEASE.2023-03-20T20-16-18Z'
MINIO_IMAGE=minio/minio:RELEASE.2023-03-20T20-16-18Z

# MySQL 数据库镜像
#   └─ 类型: string  默认值='mysql:8.4'
MYSQL_IMAGE=mysql:8.4

# ============================================================
# 生成结束
