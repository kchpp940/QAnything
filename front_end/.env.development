# ============================================================
# 前端开发环境配置
# Vite 仅暴露 VITE_ 开头的变量到前端代码
# ============================================================

# API 基地址（生产环境使用，开发环境走代理）
VITE_APP_API_HOST=/api

# API 前缀（开发环境代理匹配路径）
VITE_APP_API_PREFIX=/api

# 前端 Web 路径前缀
VITE_APP_WEB_PREFIX=/qanything

# 运行模式: dev | prod
VITE_APP_MODE=dev

# 开发环境代理目标（后端 API 地址）
# 本地开发时指向本地后端，如：http://localhost:8777
# 或使用远程开发服务器
VITE_DEV_PROXY_TARGET=http://localhost:8777
